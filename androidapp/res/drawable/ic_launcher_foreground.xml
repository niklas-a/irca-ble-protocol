<?xml version="1.0" encoding="utf-8"?>
<!--
  The setpoint dial from the app: an arc open at the bottom, running amber at
  the cold end into orange at the hot end, with the thumb dot at the top of
  the range.

  Centre (54,54), radius 27, sweeping 135 degrees round through the top to 405
  (= 45). With an 10-unit stroke that reaches 32 from centre, comfortably
  inside the 36 adaptive safe-zone radius - at radius 30 it rendered visually
  pressed against the launcher mask.

  The ramp is six overlapping round-capped segments rather than a sweep
  gradient: VectorDrawable gradients need an inline aapt:attr, and six paths
  render identically for a fraction of the complexity. Round caps make the
  joins invisible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M34.908,73.092 A27,27 0 0 1 27,54"
        android:strokeColor="#FFC14D" android:strokeWidth="10"
        android:strokeLineCap="round" />
    <path android:pathData="M27,54 A27,27 0 0 1 34.908,34.908"
        android:strokeColor="#FFAD49" android:strokeWidth="10"
        android:strokeLineCap="round" />
    <path android:pathData="M34.908,34.908 A27,27 0 0 1 54,27"
        android:strokeColor="#FF9945" android:strokeWidth="10"
        android:strokeLineCap="round" />
    <path android:pathData="M54,27 A27,27 0 0 1 73.092,34.908"
        android:strokeColor="#FF8642" android:strokeWidth="10"
        android:strokeLineCap="round" />
    <path android:pathData="M73.092,34.908 A27,27 0 0 1 81,54"
        android:strokeColor="#FF723E" android:strokeWidth="10"
        android:strokeLineCap="round" />
    <path android:pathData="M81,54 A27,27 0 0 1 73.092,73.092"
        android:strokeColor="#FF5E3A" android:strokeWidth="10"
        android:strokeLineCap="round" />

    <!-- thumb, centred on the hot end of the arc -->
    <path android:pathData="M73.092,68.992 a4.1,4.1 0 1 0 0,8.2 a4.1,4.1 0 1 0 0,-8.2z"
        android:fillColor="#FFFFFF" />
</vector>
