# ---------------------------------------------------------------------------
# NEVER COMMIT THESE
# ---------------------------------------------------------------------------
# Vendor copyrighted material. This project is lawful interoperability work
# (EU Directive 2009/24/EC Art. 6); redistributing the vendor's binary or its
# decompiled source is not. Keep them local.
apk/
decompiled/
*.apk
*.dex

# Android bugreports and Bluetooth snoop logs. Bugreport zips contain the
# phone owner's installed applications, accounts, system logs and more.
# Snoop logs contain every Bluetooth device the phone talked to.
captures/
*.btsnoop
btsnoop*.log
bugreport*.zip

# Live credentials. A device_id is a working credential for a physical heater.
device_id.txt
secrets.yaml
.env

# Raw device screenshots: the app shows the unit's model and serial number on
# screen, so these are identifying. Anything published must be cropped first
# (see docs/screenshots/ for the vetted ones).
shots/

# Signing keys. The debug keystore is generated by build.sh on first run;
# there is no reason for it to be shared.
*.keystore
*.jks

# ---------------------------------------------------------------------------
# Ordinary noise
# ---------------------------------------------------------------------------
# Leading slash matters: this is the downloaded Android SDK at the repo root,
# not androidapp/tools/, which holds the icon generator and is committed.
/tools/
androidapp/build/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.vscode/
.idea/
.DS_Store
Thumbs.db

# generated icon preview (the committed copy is docs/screenshots/app-icon.png)
androidapp/tools/icon-preview.png

# test artifacts
.pytest_cache/
